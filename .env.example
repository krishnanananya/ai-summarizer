# Shared secret checked by /api/refresh. Vercel Cron sends it automatically
# as "Authorization: Bearer <CRON_SECRET>" when this env var is set.
CRON_SECRET=change-me

# Upstash Redis (Vercel Marketplace integration fills these in automatically).
# Leave unset locally — the app falls back to a .cache/results.json file.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: Reddit sometimes 403s datacenter/ISP IPs on its public JSON API.
# If Reddit sources show FAILED in the refresh log, create a free "script" app
# at https://www.reddit.com/prefs/apps and set these — the adapters then fall
# back to app-only OAuth automatically.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Optional: GitHub token for extra rate-limit headroom on the Models tab
# (unauthenticated search allows 10 req/min — plenty for the daily cron).
GITHUB_TOKEN=

# Gemini API key (free at https://aistudio.google.com/apikey) — powers the
# Chat tab. Server-side only; never shipped to the browser. Without it the
# Chat tab shows a configuration error but the rest of the app works.
GEMINI_API_KEY=
# Optional model override (default gemini-2.5-flash).
# GEMINI_MODEL=
